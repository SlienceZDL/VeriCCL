{
  "collective": {
    "operator": "allreduce",
    "inplace": false
  },
  "hyperparameters": {
    "total_size_bytes": 2048,
    "slice_size_bytes": 1024
  },
  "solver": {
    "per_model_timeout_s": 5,
    "cpu_budget": 2,
    "max_channels": 1,
    "max_threads_per_model": 1,
    "max_parallel_models": 1,
    "solver_seed": 0
  },
  "budgets": {
    "max_initial_synthesis_s": 20,
    "max_offline_validation_per_round_s": 10,
    "max_offline_validation_total_s": 30,
    "max_repair_per_round_s": 10,
    "max_repair_total_s": 30,
    "max_tuning_rounds": 0,
    "cleanup_reserve_s": 0.5
  },
  "tolerances": {
    "absolute": 1e-05,
    "relative": 1e-05
  },
  "calibration": {
    "enabled": false
  }
}
