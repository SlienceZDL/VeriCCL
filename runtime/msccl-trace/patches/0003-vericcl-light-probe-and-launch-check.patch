+extern "C" __attribute__((visibility("default")))
+ncclResult_t vericclProbeAttach(ncclComm_t comm, VericclProbeCounter* table, size_t entries) {
+  if (comm == NULL || (table == NULL) != (entries == 0)) return ncclInvalidArgument;
+  int device = -1;
+  CUDACHECK(cudaGetDevice(&device));
+  if (device != comm->cudaDev || comm->hostDevComm.mscclInfo == NULL) return ncclInvalidUsage;
+  if (comm->mscclHostComm.traceEnabled) return ncclInvalidUsage;
+  if (table != NULL) {
+    cudaPointerAttributes attributes;
+    CUDACHECK(cudaPointerGetAttributes(&attributes, table));
+    if (attributes.type != cudaMemoryTypeDevice || attributes.device != device) return ncclInvalidArgument;
+  }
+  CUDACHECK(cudaDeviceSynchronize());
+  comm->mscclHostComm.mscclDevComm.probeTable = table;
+  comm->mscclHostComm.mscclDevComm.probeTableEntries = entries;
+  CUDACHECK(cudaMemcpy(&comm->hostDevComm.mscclInfo->probeTable, &table, sizeof(table), cudaMemcpyHostToDevice));
+  CUDACHECK(cudaMemcpy(&comm->hostDevComm.mscclInfo->probeTableEntries, &entries, sizeof(entries), cudaMemcpyHostToDevice));
+  return ncclSuccess;
+}
