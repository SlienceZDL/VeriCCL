 // Compute enqueue element, save it in list
 // Compute CUDA launch parameters
+// VeriCCL: resident-TB admission limit per (device, kernel, block size).
+// cudaGetDeviceProperties takes milliseconds on recent drivers; querying it
+// on every MSCCL launch dominated small collectives. The limit depends only
+// on the device, the selected kernel and its thread count, so it is computed
+// once with cheap attribute/occupancy queries and cached.
+static ncclResult_t vericclResidentLimit(int device, int funcIndex, int nThreads, int* limit) {
+  static std::mutex lock;
+  static std::map<std::tuple<int, int, int>, int> cache;
+  const std::tuple<int, int, int> key(device, funcIndex, nThreads);
+  {
+    std::lock_guard<std::mutex> guard(lock);
+    auto found = cache.find(key);
+    if (found != cache.end()) { *limit = found->second; return ncclSuccess; }
+  }
+  int multiprocessors = 0, resident = 0;
+  CUDACHECK(cudaDeviceGetAttribute(&multiprocessors, cudaDevAttrMultiProcessorCount, device));
+  CUDACHECK(cudaOccupancyMaxActiveBlocksPerMultiprocessor(&resident, ncclKerns[funcIndex], nThreads, 0));
+  *limit = resident > 0 ? resident * multiprocessors : 0;
+  std::lock_guard<std::mutex> guard(lock);
+  cache[key] = *limit;
+  return ncclSuccess;
+}
