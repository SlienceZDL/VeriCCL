+static ncclResult_t vericclCheckStepSignature(
+    const char* name, int actual) {
+  const char* value = getenv(name);
+  if (value == NULL || value[0] == '\0') return ncclSuccess;
+  char* end = NULL;
+  errno = 0;
+  long expected = strtol(value, &end, 10);
+  if (errno != 0 || end == value || *end != '\0' || expected != actual) {
+    WARN("%s=%s does not match VeriCCL runtime value %d", name, value, actual);
+    return ncclInvalidArgument;
+  }
+  return ncclSuccess;
+}
+
+static void vericclTraceDiscard(ncclComm_t comm) {
+  struct mscclHostCommInfo* hostInfo = &comm->mscclHostComm;
+  struct mscclDevCommInfo* traceInfo = &hostInfo->mscclDevComm;
+  if (traceInfo->traceRecords != NULL)
+    CUDACHECKIGNORE(cudaFree(traceInfo->traceRecords));
+  if (traceInfo->traceRecordCount != NULL)
+    CUDACHECKIGNORE(cudaFree(traceInfo->traceRecordCount));
+  if (traceInfo->traceOverflow != NULL)
+    CUDACHECKIGNORE(cudaFree(traceInfo->traceOverflow));
+  traceInfo->traceRecords = NULL;
+  traceInfo->traceRecordCount = NULL;
+  traceInfo->traceOverflow = NULL;
+  traceInfo->traceCapacity = 0;
+  free(hostInfo->traceFilePrefix);
+  hostInfo->traceFilePrefix = NULL;
+  hostInfo->traceEnabled = 0;
+}
+
+static ncclResult_t vericclTraceInit(ncclComm_t comm) {
+  struct mscclHostCommInfo* hostInfo = &comm->mscclHostComm;
+  struct mscclDevCommInfo* traceInfo = &hostInfo->mscclDevComm;
+  const char* enabled = getenv("VERICCL_TRACE_ENABLE");
+  if (enabled == NULL || enabled[0] == '\0' || strcmp(enabled, "0") == 0) {
+    return ncclSuccess;
+  }
+
+  unsigned long long capacity = 1048576ULL;
+  const char* recordsValue = getenv("VERICCL_TRACE_RECORDS");
+  if (recordsValue != NULL && recordsValue[0] != '\0') {
+    char* end = NULL;
+    errno = 0;
+    capacity = strtoull(recordsValue, &end, 10);
+    if (errno != 0 || end == recordsValue || *end != '\0' || capacity == 0 ||
+        capacity > SIZE_MAX / sizeof(VericclRawStepTraceRecord)) {
+      WARN("Invalid VERICCL_TRACE_RECORDS value: %s", recordsValue);
+      return ncclInvalidArgument;
+    }
+  }
+
+  const char* prefix = getenv("VERICCL_TRACE_FILE_PREFIX");
+  if (prefix == NULL || prefix[0] == '\0') prefix = "vericcl-trace";
+  hostInfo->traceFilePrefix = strdup(prefix);
+  if (hostInfo->traceFilePrefix == NULL) return ncclSystemError;
+
+  traceInfo->traceCapacity = capacity;
+  ncclResult_t res = ncclSuccess;
+  NCCLCHECKGOTO(ncclCudaCalloc(
+      &traceInfo->traceRecords, (size_t)capacity), res, trace_init_fail);
+  NCCLCHECKGOTO(
+      ncclCudaCalloc(&traceInfo->traceRecordCount, 1), res, trace_init_fail);
+  NCCLCHECKGOTO(
+      ncclCudaCalloc(&traceInfo->traceOverflow, 1), res, trace_init_fail);
+  hostInfo->traceEnabled = 1;
+  return ncclSuccess;
+
+trace_init_fail:
+  vericclTraceDiscard(comm);
+  return res;
+}
+
+static ncclResult_t vericclTraceFlush(ncclComm_t comm) {
+  struct mscclHostCommInfo* hostInfo = &comm->mscclHostComm;
+  struct mscclDevCommInfo* traceInfo = &hostInfo->mscclDevComm;
+  if (!hostInfo->traceEnabled || traceInfo->traceRecords == NULL) {
+    return ncclSuccess;
+  }
+
+  unsigned long long reservedCount = 0;
+  unsigned int overflow = 0;
+  CUDACHECK(cudaMemcpy(
+      &reservedCount, traceInfo->traceRecordCount,
+      sizeof(reservedCount), cudaMemcpyDeviceToHost));
+  CUDACHECK(cudaMemcpy(
+      &overflow, traceInfo->traceOverflow,
+      sizeof(overflow), cudaMemcpyDeviceToHost));
+  const unsigned long long recordCount =
+      reservedCount < traceInfo->traceCapacity
+          ? reservedCount
+          : traceInfo->traceCapacity;
+  const size_t recordsBytes =
+      (size_t)recordCount * sizeof(VericclRawStepTraceRecord);
+  VericclRawStepTraceRecord* records = NULL;
+  if (recordsBytes > 0) {
+    records = (VericclRawStepTraceRecord*)malloc(recordsBytes);
+    if (records == NULL) return ncclSystemError;
+    cudaError_t copyResult = cudaMemcpy(
+        records, traceInfo->traceRecords, recordsBytes,
+        cudaMemcpyDeviceToHost);
+    if (copyResult != cudaSuccess) {
+      free(records);
+      return ncclUnhandledCudaError;
+    }
+  }
+
+  const size_t pathLength = strlen(hostInfo->traceFilePrefix) + 48;
+  char* path = (char*)malloc(pathLength);
+  if (path == NULL) {
+    free(records);
+    return ncclSystemError;
+  }
+  snprintf(
+      path, pathLength, "%s.rank-%d.bin",
+      hostInfo->traceFilePrefix, comm->rank);
+  FILE* output = fopen(path, "wb");
+  free(path);
+  if (output == NULL) {
+    free(records);
+    return ncclSystemError;
+  }
+
+  VericclRawTraceHeader header;
+  memset(&header, 0, sizeof(header));
+  header.magic = VERICCL_TRACE_MAGIC;
+  header.version = VERICCL_TRACE_VERSION;
+  header.header_size = (uint16_t)sizeof(header);
+  header.record_size = (uint32_t)sizeof(VericclRawStepTraceRecord);
+  header.rank = (uint32_t)comm->rank;
+  header.count = (uint64_t)recordCount;
+  header.capacity = (uint64_t)traceInfo->traceCapacity;
+  header.overflow = overflow ? VERICCL_TRACE_FLAG_OVERFLOW : 0;
+
+  bool writeOk = fwrite(&header, sizeof(header), 1, output) == 1;
+  if (writeOk && recordCount > 0) {
+    writeOk = fwrite(
+        records, sizeof(VericclRawStepTraceRecord),
+        (size_t)recordCount, output) == (size_t)recordCount;
+  }
+  if (fclose(output) != 0) writeOk = false;
+  free(records);
+  return writeOk ? ncclSuccess : ncclSystemError;
+}
