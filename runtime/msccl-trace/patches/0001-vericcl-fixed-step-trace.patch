+#define MSCCL_TRACE_SEND_LINK 0x1U
+#define MSCCL_TRACE_RECV_LINK 0x2U
+#define MSCCL_TRACE_DEVICE 0x4U
+
+__device__ __forceinline__ uint64_t mscclTraceClock() {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 700
+  uint64_t timestamp = 0;
+  asm volatile("mov.u64 %0, %%globaltimer;" : "=l"(timestamp));
+  return timestamp;
+#else
+  return clock64();
+#endif
+}
+
+__device__ __forceinline__ void mscclTraceStart(
+    VericclRawStepTraceRecord* trace) {
+  if (trace != NULL) {
+    const unsigned long long timestamp =
+        (unsigned long long)mscclTraceClock();
+    atomicCAS(
+        (unsigned long long*)&trace->transfer_start, 0ULL, timestamp);
+  }
+}
+
+__device__ __forceinline__ uint32_t mscclTraceResourceMask(uint8_t type) {
+  switch (type) {
+    case MSCCL_SEND:
+      return MSCCL_TRACE_SEND_LINK;
+    case MSCCL_RECV:
+      return MSCCL_TRACE_RECV_LINK;
+    case MSCCL_RECV_COPY_SEND:
+    case MSCCL_RECV_REDUCE_SEND:
+    case MSCCL_RECV_REDUCE_COPY_SEND:
+      return MSCCL_TRACE_RECV_LINK | MSCCL_TRACE_SEND_LINK |
+             MSCCL_TRACE_DEVICE;
+    case MSCCL_RECV_REDUCE_COPY:
+      return MSCCL_TRACE_RECV_LINK | MSCCL_TRACE_DEVICE;
+    case MSCCL_LOCAL_COPY:
+    case MSCCL_REDUCE:
+      return MSCCL_TRACE_DEVICE;
+    default:
+      return 0;
+  }
+}
